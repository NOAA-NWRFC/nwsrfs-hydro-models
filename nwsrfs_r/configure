#!/bin/sh
# Package configure script.
#
# root_module.f90 (vendored roots-fortran) uses internal procedures passed as
# callbacks. On newer gfortran (GCC 14+, including CRAN's Debian gcc), the
# compiler emits stack trampolines for these, which mark the shared object's
# stack executable. Modern hardened loaders refuse to load such an object:
#
#   root_module.o: requires executable stack (because the .note.GNU-stack
#   section is executable)
#   cannot enable executable stack as shared object requires: Invalid argument
#
# GCC 14 added -ftrampoline-impl=heap to allocate trampolines on the heap
# instead, avoiding the executable stack. This script probes the Fortran
# compiler R will use and enables that flag only when it is supported, then
# generates src/Makevars from src/Makevars.in. On macOS and older gfortran the
# flag is omitted and the build is unchanged.

set -e

# Use the same Fortran compiler and flags R itself uses.
: "${R_HOME=$(R RHOME)}"
RBIN="${R_HOME}/bin/R"
FC=$("${RBIN}" CMD config FC)
FFLAGS=$("${RBIN}" CMD config FFLAGS)

TRAMPOLINE_FFLAGS=""

# Probe: compile a trivial Fortran unit with the candidate flag. Discard all
# output; we only care about the exit status. Some compilers accept unknown
# -f options with a warning, so we test against a real compile.
tmpd=$(mktemp -d 2>/dev/null || echo "./conftest.$$")
mkdir -p "${tmpd}"
cat > "${tmpd}/conftest.f90" <<'EOF'
program conftest
end program conftest
EOF

if ${FC} ${FFLAGS} -ftrampoline-impl=heap -c "${tmpd}/conftest.f90" \
        -o "${tmpd}/conftest.o" >/dev/null 2>&1; then
    TRAMPOLINE_FFLAGS="-ftrampoline-impl=heap"
    echo "configure: Fortran compiler supports -ftrampoline-impl=heap; enabling it"
else
    echo "configure: Fortran compiler lacks -ftrampoline-impl=heap; leaving flags unchanged"
fi

rm -rf "${tmpd}"

# Generate src/Makevars from the template.
sed "s|@TRAMPOLINE_FFLAGS@|${TRAMPOLINE_FFLAGS}|g" \
    src/Makevars.in > src/Makevars

echo "configure: generated src/Makevars"
exit 0
