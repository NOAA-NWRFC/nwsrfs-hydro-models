# Template for src/Makevars, filled in by the package `configure` script.
# The placeholder below is replaced with -ftrampoline-impl=heap when the Fortran
# compiler supports it (GCC 14+, including CRAN's Debian gcc), otherwise with
# nothing. root_module.f90 uses internal procedures passed as callbacks; on
# newer toolchains gfortran emits stack trampolines that mark the shared
# object's stack executable, which modern loaders refuse (CRAN Debian: "cannot
# enable executable stack ..."). Heap trampolines avoid the executable stack,
# and the flag is omitted on macOS or older gfortran so nothing changes there.
PKG_FFLAGS = @TRAMPOLINE_FFLAGS@ #-Wall -pedantic #-O3 #-fno-align-commons -ffixed-line-length-none #-std=f95
PKG_FCFLAGS = @TRAMPOLINE_FFLAGS@ #-mmacosx-version-min=11.1 #-Wall -pedantic #-O3 #-fno-align-commons -ffixed-line-length-none #-std=f95

all: $(SHLIB)

# need to tell R the order to compile dependent modules
sac_snow_only_tci.o sac_snow_states.o: utilities.o
FA.o: utilities.o
utilities.o: types.o stats.o sorting.o
stats.o: types.o sorting.o
uh2p_get_scale.o: uh_optim.o
uh_optim.o: root_module.o

# These files use obsolete features and so fail when using the default -std=f95
fka7.o: fka7.f
	$(FC) -c -fPIC -O2 fka7.f
flag7.o: flag7.f
	$(FC) -c -fPIC -O2 flag7.f
pin7.o: pin7.f
	$(FC) -c -fPIC -O2 pin7.f
ex57.o: ex57.f
	$(FC) -c -fPIC -O2 ex57.f
SNDEPTH.o: SNDEPTH.f
	$(FC) -c -fPIC -O2 SNDEPTH.f
exsnow19.o: exsnow19.f
	$(FC) -c -fPIC -O2 exsnow19.f
